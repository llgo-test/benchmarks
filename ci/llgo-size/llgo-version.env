# Updating LLGO_REPOSITORY or LLGO_COMMIT deliberately triggers the binary-size
# workflow. This PR temporarily pins the backend-release experiment.
# Restore xgo-dev/llgo first-parent main before merging this diagnostic branch.
# GO_VERSION is the default WASM application standard-library baseline.
# LLGO_BUILD_GO_VERSION independently pins the toolchain needed to build LLGo.
# Keep the pinned LLGo revision compatible with both and with LLVM_VERSION.
LLGO_REPOSITORY=zhouguangyuan0718/llgo
LLGO_COMMIT=455b5d7487b048db633e9d86e0f12d92173d00e0
LLGO_BUILD_GO_VERSION=1.27.0
GO_VERSION=1.26.2
LLVM_VERSION=22
TINYGO_VERSION=0.41.1
TINYGO_LINUX_AMD64_SHA256=e156d1d93a376eef639a4143d13be07e8c463fb6cf2d7d447698ed4474d23e91
BINARYEN_VERSION=132
BINARYEN_LINUX_AMD64_SHA256=195ddc94f9bc89f45abdabb0b9eea86023d727ba90eac8b35b80f2544fc30572
